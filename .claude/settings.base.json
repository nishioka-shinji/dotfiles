{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/protect-branch.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/confirm-destructive-git.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer|reviewer|integrator",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/require-verification.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "outputStyle": "Concise",
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "fastMode": true,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true
}
